   "source": [
    "def minCostClimbingStairs(cost):\n",
    "    n = len(cost)\n",
    "    dp = [0] * (n + 1)\n",
    "    \n",
    "    for i in range(2, n + 1):\n",
    "        dp[i] = min(dp[i-1] + cost[i-1], dp[i-2] + cost[i-2])\n",
    "    \n",
    "    return dp[n]"
   ]
  },
